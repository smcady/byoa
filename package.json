{
  "name": "byoa",
  "version": "0.1.0",
  "description": "Multi-user, multi-agent collaborative workspace via MCP. Reference implementation of the BYOA (Bring Your Own Agent) pattern.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "byoa": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smcady/byoa.git"
  },
  "keywords": [
    "mcp",
    "multi-agent",
    "byoa",
    "bring-your-own-agent",
    "collaboration",
    "claude-code",
    "model-context-protocol",
    "agent-proxy"
  ],
  "author": "Shawn Cady",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "grammy": "^1.42.0",
    "nanoid": "^5.0.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
